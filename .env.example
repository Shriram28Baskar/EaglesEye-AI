# ─── Database ───────────────────────────────────────────
POSTGRES_DB=eagleseye
POSTGRES_USER=eagleseye
POSTGRES_PASSWORD=eagleseye_secret
DATABASE_URL=postgresql+asyncpg://eagleseye:eagleseye_secret@localhost:5433/eagleseye

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ─── LLM (Groq) ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
OPENAI_API_KEY=

# ─── Vapi (Outbound Voice Calls) ────────────────────────
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# ─── Twilio (Emergency SMS / Voice Backup) ──────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
PRIMARY_DOCTOR_PHONE=+919035890001
ESCALATION_SUPERVISOR_PHONE=+919363179481

# ─── Optional ───────────────────────────────────────────
GOOGLE_SHEETS_WEBHOOK_URL=

# ─── App Configuration ──────────────────────────────────
BACKEND_PORT=8001
FRONTEND_PORT=8080
ENVIRONMENT=development

# ─── Frontend Environment (Vite) ────────────────────────
VITE_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001
